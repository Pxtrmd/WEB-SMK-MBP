# ============ WAJIB (Fase 1) ============
DATABASE_URL="postgresql://sekolah:sekolah@localhost:5432/sekolah?schema=public"
# Minimal 32 karakter acak. Buat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
APP_URL="http://localhost:3000"

# ============ Penyimpanan berkas (opsional sampai modul unggah dibuat) ============
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_BUCKET="sekolah-files"
MAX_UPLOAD_MB="50"

# ============ Seed database (hanya dipakai `npm run db:seed`, bukan oleh aplikasi) ============
SEED_ADMIN_EMAIL="admin@sekolah.test"
SEED_ADMIN_PASSWORD="ganti-dengan-password-kuat-12+"
SEED_DEMO="false"
# SEED_DEMO_PASSWORD="isi-jika-SEED_DEMO=true"

# ============ Autentikasi (Fase 3; semua opsional, nilai di bawah = bawaan) ============
# SESSION_TTL_HOURS="24"
# LOGIN_MAX_ATTEMPTS="5"
# LOGIN_LOCKOUT_MINUTES="15"
# RESET_TOKEN_TTL_MINUTES="30"
# ACTIVATION_TOKEN_TTL_HOURS="72"
# EMAIL_DRIVER="console"        # console = cetak tautan di terminal (pengembangan); smtp = kirim surel
# EMAIL_FROM="Sekolah <no-reply@sekolah.test>"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
